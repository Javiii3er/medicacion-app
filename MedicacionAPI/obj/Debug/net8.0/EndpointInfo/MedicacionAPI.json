        "properties": {
          "correo": {
            "type": "string",
            "nullable": true
          },
          "contrasena": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RegistroDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "nullable": true
          },
          "apellido": {
            "type": "string",
            "nullable": true
          },
          "correo": {
            "type": "string",
            "nullable": true
          },
          "contrasena": {
            "type": "string",
            "nullable": true
          },
          "rol": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "description": "JWT Authorization header. Ejemplo: 'Bearer {token}'",
        "name": "Authorization",
