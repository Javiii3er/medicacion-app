<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HelloWorldMAUI.Views.EditarMedicamentoPage"
             Title="Editar medicamento"
             BackgroundColor="#F5F7FA">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">

            <Label Text="Nombre del medicamento"
                   FontSize="12" FontAttributes="Bold" TextColor="#5B6570"/>
            <Border BackgroundColor="White" StrokeThickness="1.5"
                    Stroke="#E4E8ED" StrokeShape="RoundRectangle 10">
                <Entry x:Name="EntryNombre" FontSize="14" Margin="12,8"/>
            </Border>

            <Label Text="Dosis" FontSize="12" FontAttributes="Bold" TextColor="#5B6570"/>
            <Border BackgroundColor="White" StrokeThickness="1.5"
                    Stroke="#E4E8ED" StrokeShape="RoundRectangle 10">
                <Entry x:Name="EntryDosis" Keyboard="Numeric"
                       FontSize="14" Margin="12,8"/>
            </Border>

            <Label Text="Unidad de medida" FontSize="12" FontAttributes="Bold" TextColor="#5B6570"/>
            <Border BackgroundColor="White" StrokeThickness="1.5"
                    Stroke="#E4E8ED" StrokeShape="RoundRectangle 10">
                <Entry x:Name="EntryUnidad" FontSize="14" Margin="12,8"/>
            </Border>

            <Label Text="Frecuencia" FontSize="12" FontAttributes="Bold" TextColor="#5B6570"/>
            <Border BackgroundColor="White" StrokeThickness="1.5"
                    Stroke="#E4E8ED" StrokeShape="RoundRectangle 10">
                <Entry x:Name="EntryFrecuencia" FontSize="14" Margin="12,8"/>
            </Border>

            <Label Text="Hora de administración" FontSize="12" FontAttributes="Bold" TextColor="#5B6570"/>
            <Border BackgroundColor="White" StrokeThickness="1.5"
                    Stroke="#185FA5" StrokeShape="RoundRectangle 10">
                <TimePicker x:Name="TimerHora" Format="HH:mm"
                            FontSize="14" Margin="12,8"/>
            </Border>

            <Label Text="Notas (opcional)" FontSize="12" FontAttributes="Bold" TextColor="#5B6570"/>
            <Border BackgroundColor="White" StrokeThickness="1.5"
                    Stroke="#E4E8ED" StrokeShape="RoundRectangle 10">
                <Editor x:Name="EditorNotas" FontSize="14"
                        HeightRequest="80" Margin="12,8"/>
            </Border>

            <Label x:Name="LblError" TextColor="#D32F2F"
                   FontSize="12" IsVisible="False" HorizontalOptions="Center"/>

            <Button Text="Guardar cambios"
                    FontSize="15" FontAttributes="Bold"
                    BackgroundColor="#185FA5" TextColor="White"
                    CornerRadius="12" HeightRequest="52"
                    Clicked="OnGuardarClicked" Margin="0,8,0,0"/>

            <Button Text="Eliminar medicamento"
                    FontSize="14" FontAttributes="Bold"
                    BackgroundColor="#FDECEA" TextColor="#D32F2F"
                    CornerRadius="12" HeightRequest="48"
                    Clicked="OnEliminarClicked"/>

            <Button Text="Cancelar"
                    FontSize="14" BackgroundColor="Transparent"
                    TextColor="#5B6570" Clicked="OnCancelarClicked"/>

            <ActivityIndicator x:Name="Loading"
                               IsRunning="False" IsVisible="False"
                               Color="#185FA5" HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>