<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HelloWorldMAUI.Views.AgregarMedicamentoPage"
             Title="Agregar medicamento"
             BackgroundColor="#F5F7FA">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">

            <!-- Nombre -->
            <Label Text="Nombre del medicamento"
                   FontSize="12" FontAttributes="Bold" TextColor="#5B6570"/>
            <Border BackgroundColor="White" StrokeThickness="1.5"
                    Stroke="#E4E8ED" StrokeShape="RoundRectangle 10">
                <Entry x:Name="EntryNombre" Placeholder="Ej. Losartán"
                       FontSize="14" Margin="12,8"/>
            </Border>

            <!-- Dosis -->
            <Label Text="Dosis" FontSize="12" FontAttributes="Bold" TextColor="#5B6570"/>
            <Border BackgroundColor="White" StrokeThickness="1.5"
                    Stroke="#E4E8ED" StrokeShape="RoundRectangle 10">
                <Entry x:Name="EntryDosis" Placeholder="Ej. 50"
                       Keyboard="Numeric" FontSize="14" Margin="12,8"/>
            </Border>

            <!-- Unidad -->
            <Label Text="Unidad de medida" FontSize="12" FontAttributes="Bold" TextColor="#5B6570"/>
            <Border BackgroundColor="White" StrokeThickness="1.5"
                    Stroke="#E4E8ED" StrokeShape="RoundRectangle 10">
                <Entry x:Name="EntryUnidad" Placeholder="Ej. mg, ml, tableta"
                       FontSize="14" Margin="12,8"/>
            </Border>

            <!-- Frecuencia -->
            <Label Text="Frecuencia" FontSize="12" FontAttributes="Bold" TextColor="#5B6570"/>
            <Border BackgroundColor="White" StrokeThickness="1.5"
                    Stroke="#E4E8ED" StrokeShape="RoundRectangle 10">
                <Entry x:Name="EntryFrecuencia" Placeholder="Ej. Una vez al día"
                       FontSize="14" Margin="12,8"/>
            </Border>

            <!-- Hora -->
            <Label Text="Hora de administración" FontSize="12" FontAttributes="Bold" TextColor="#5B6570"/>
            <Border BackgroundColor="White" StrokeThickness="1.5"
                    Stroke="#185FA5" StrokeShape="RoundRectangle 10">
                <TimePicker x:Name="TimerHora" Format="HH:mm"
                            FontSize="14" Margin="12,8"/>
            </Border>

            <!-- Notas -->
            <Label Text="Notas (opcional)" FontSize="12" FontAttributes="Bold" TextColor="#5B6570"/>
            <Border BackgroundColor="White" StrokeThickness="1.5"
                    Stroke="#E4E8ED" StrokeShape="RoundRectangle 10">
                <Editor x:Name="EditorNotas" Placeholder="Instrucciones especiales..."
                        FontSize="14" HeightRequest="80" Margin="12,8"/>
            </Border>

            <!-- Error -->
            <Label x:Name="LblError" TextColor="#D32F2F"
                   FontSize="12" IsVisible="False" HorizontalOptions="Center"/>

            <!-- Botón guardar -->
            <Button Text="Guardar medicamento"
                    FontSize="15" FontAttributes="Bold"
                    BackgroundColor="#2E7D32" TextColor="White"
                    CornerRadius="12" HeightRequest="52"
                    Clicked="OnGuardarClicked" Margin="0,8,0,0"/>

            <!-- Botón cancelar -->
            <Button Text="Cancelar"
                    FontSize="14"
                    BackgroundColor="Transparent"
                    TextColor="#5B6570"
                    Clicked="OnCancelarClicked"/>

            <ActivityIndicator x:Name="Loading"
                               IsRunning="False" IsVisible="False"
                               Color="#185FA5" HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>